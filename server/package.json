{
  "name": "daaktarsahab-server",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "migrate:mysql": "node --env-file-if-exists=.env src/scripts/migrateFromMysql.js",
    "train-model": "node src/ml/train.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "mysql2": "^3.24.5"
  }
}
