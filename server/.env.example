# Copy to server/.env and adjust.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/daaktarsahab

# Signs the sign-in cookie. Any long random string; required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The React app's address (used to build password-reset links).
CLIENT_ORIGIN=http://localhost:5173

# There is no email service yet, so in development the forgot-password page
# shows the reset link on screen (as the PHP version did). Off in production,
# where the link is written to the server log instead.
# SHOW_RESET_LINKS=true

# Where chat attachments are stored (default: server/uploads/chat).
# UPLOAD_DIR=

# First admin account, created by "npm run seed" when there is none.
# ADMIN_EMAIL=admin@doctorproject.com
# ADMIN_PASSWORD=admin123

# Old MySQL database, read by "npm run migrate:mysql" (WAMP defaults).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=doctorProject
# CHAT_UPLOAD_DIR_OLD=C:/wamp64/doctorproject_uploads/chat
